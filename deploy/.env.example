# ---- copy to .env and fill in. Never commit .env ----
DOMAIN=app.yourfamilyoffice.in
API_DOMAIN=api.yourfamilyoffice.in
GH_ORG=your-github-org
IMAGE_TAG=latest

POSTGRES_PASSWORD=change-me-32-chars
APP_DB_PASSWORD=change-me-32-chars
MINIO_ROOT_USER=familyoffice
MINIO_ROOT_PASSWORD=change-me-32-chars

# API
NODE_ENV=production
JWT_SECRET=change-me-64-chars
REFRESH_SECRET=change-me-64-chars
FIELD_ENCRYPTION_KEY=base64-32-bytes   # openssl rand -base64 32 ; encrypts PAN and account numbers
CORS_ORIGIN=https://app.yourfamilyoffice.in

# Email (SES or Postmark)
SMTP_HOST=email-smtp.ap-south-1.amazonaws.com
SMTP_USER=
SMTP_PASS=
MAIL_FROM=noreply@yourfamilyoffice.in
INGEST_DOMAIN=ingest.yourfamilyoffice.in
RESEARCH_INGEST_DOMAIN=research.yourfamilyoffice.in
WHATSAPP_BSP=                              # gupshup | twilio (research inbox, P1)
WHATSAPP_BSP_KEY=

# Account Aggregator (Finvu sandbox first)
AA_PROVIDER=finvu
AA_CLIENT_ID=
AA_CLIENT_SECRET=
AA_WEBHOOK_SECRET=

# Action plane
EXECUTOR_DB_PASSWORD=change-me-32-chars      # role executor_user (created by db/008); set: alter role executor_user with password '...'
VAULT_TOKEN_API=                           # API token: write/revoke connector credentials only
VAULT_TOKEN_EXECUTOR=                      # executor token: read only, bound to role 'executor'
ANTHROPIC_API_KEY=                         # assistant (API/worker only; the executor has no LLM access)
ANTHROPIC_MODEL=claude-sonnet-4-6
APPROVAL_EXPIRY_HOURS=24
SANDBOX_ONLY=true                          # keep true until each connector passes its dry-run

# Push
EXPO_ACCESS_TOKEN=

# Backups (rclone remote to any S3/B2/GDrive; see scripts/backup.sh)
RCLONE_REMOTE=b2:familyoffice-backups
RCLONE_CONFIG_B2_TYPE=b2
RCLONE_CONFIG_B2_ACCOUNT=
RCLONE_CONFIG_B2_KEY=
BACKUP_RETAIN_DAYS=35

# documents & reports (Milestone 10)
# S3_ENDPOINT / S3_BUCKET / S3_ACCESS_KEY / S3_SECRET_KEY come from compose (MinIO); STORAGE_DIR is the filesystem fallback when S3 is not configured
S3_SSE=AES256                              # server-side encryption header on every PUT (MinIO needs KMS configured; set empty to disable)
S3_PUBLIC_ENDPOINT=                        # browser-reachable MinIO/S3 URL for presigned links; empty = downloads are streamed through the API (/files/:token)
PUBLIC_API_URL=/api/v1                     # base for signed download links in e-mails (e.g. https://wealthprism.in/api/v1)
PUBLIC_WEB_URL=                            # base for invitation links to external viewers
SCAN_COMMAND=                              # e.g. "clamdscan --no-summary" — exit 0 clean, 1 infected; empty = scan skipped (recorded on the document)
EXTRACTION_AUTO_THRESHOLD=0.9              # extractions at or above land as "extracted" (still approved by a person); below → needs_review
# ---- Milestone 12: banking AA, delivery, ingest, feeds ----
AA_BASE_URL=https://aauat.finvu.in/API/V1        # Finvu UAT; production and other AAs (Onemoney, Setu) set their own base + paths
AA_WEB_URL=https://webvwdev.finvu.in/consent     # the AA's consent page the customer is sent to
AA_FIU_ID=                                       # your FIU id with the AA
AA_CONSENT_TEMPLATE=WEALTHPRISM_DEPOSIT_12M
AA_HANDLE_SUFFIX=finvu                           # customer handle = <mobile>@<suffix>
AA_PROVIDER_PUBLIC_KEY=                          # PEM; verifies the AA's detached JWS on the webhook (else X-AA-Signature HMAC with AA_WEBHOOK_SECRET)
AA_SYNC_ENABLED=true                             # worker fetches every active consent four-hourly
EMAIL_TRANSPORT=log                              # log | ses | smtp
AWS_REGION=ap-south-1                            # SES v2 (uses AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY); SES_CONFIGURATION_SET optional
SMTP_PORT=587
SMTP_SECURE=false                                # true for implicit TLS on 465; STARTTLS is used when the server offers it
WHATSAPP_PROVIDER=log                            # log | meta | gupshup
WHATSAPP_TOKEN=                                  # Meta Cloud API
WHATSAPP_PHONE_ID=
WHATSAPP_SOURCE=                                 # Gupshup source number (with WHATSAPP_BSP_KEY)
SMS_PROVIDER=log                                 # log | msg91 | twilio
MSG91_AUTHKEY=
MSG91_SENDER=WLTHPR
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
INGEST_WEBHOOK_SECRET=change-me                  # the mail gateway signs POST /ingest/email with HMAC-SHA256 over the raw body
INGEST_PDF_PASSWORDS=                            # comma-separated passwords tried on e-mailed PDFs (holders' PANs)
FEED_RETRIES=3
FEED_TIMEOUT_MS=20000
BSE_FALLBACK=true                                # BSE bhavcopy when the NSE archive fails
NIFTY_TRI_ENABLED=true                           # total-return history from niftyindices (NIFTY_TRI_INDICES="NIFTY 50,NIFTY 500")
BENCHMARK_SERIES_URLS=                           # licensed series as CSV/JSON: CRISIL_CBI=https://…/cbi.csv;OTHER=https://…
# ---- Milestone 13: residue (global module, MF Central, invitations) ----
FX_RATES_URL=                                    # daily reference rates as JSON ({base, date, rates}); empty = owner-entered rates only (PUT /fx-rates)
MFCENTRAL_URL=                                   # MF Central CAS request endpoint; empty = the refresh is recorded and the statement is expected by e-mail
MFCENTRAL_TOKEN=
# PUBLIC_WEB_URL (above) is also the base for member invitation links: <PUBLIC_WEB_URL>/invite?email=…&token=…
# ---- Milestone 14: Tally live sync, MCP ----
TALLY_URL=                                       # default HTTP gateway of a running Tally (http://host:9000); per-book tally_url overrides it
# MCP clients (Claude Desktop / Cursor) run `pnpm --filter @fo/api mcp` with:
FO_API_URL=http://localhost:4000/api/v1          # the API the MCP server talks to
FO_API_KEY=                                      # an API key from Reports → Open data (read scopes = read-only assistant)
# ---- Milestone 15: scanned documents ----
OCR_COMMAND=                                     # e.g. "tesseract {in} stdout -l eng" or "ocrmypdf --sidecar - {in} /dev/null"; empty = scanned PDFs / images are tagged needs-ocr
OCR_TIMEOUT_MS=120000
