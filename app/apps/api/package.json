    "start": "node dist/server.js",
    "migrate": "tsx src/migrate.ts",
    "seed": "tsx src/migrate.ts --seed",
    "test": "vitest run",
    "worker": "tsx src/worker.ts",
    "cli": "tsx src/cli.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "mcp": "tsx src/mcp.ts",
    "rotate-field-key": "tsx src/rotatekey.ts"
  },
  "dependencies": {
    "@fo/connectors": "workspace:*",
    "@fo/finance": "workspace:*",
    "@fo/reports": "workspace:*",
    "@fastify/cors": "^10.0.0",
    "@fastify/static": "^8.0.0",
    "bcryptjs": "^2.4.3",
    "fastify": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.0",
    "zod": "^3.23.8",
    "yaml": "^2.6.0",
    "@fo/parsers": "workspace:*",
    "@fastify/multipart": "^9.0.1",
    "@fastify/rate-limit": "^10.1.1",
    "@fastify/helmet": "^13.0.0",
    "@simplewebauthn/server": "^11.0.0",
    "imapflow": "^1.0.167",
    "mailparser": "^3.7.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.10",
    "@types/mailparser": "^3.4.5",
